# ========================================================
# COLLEGE QUIZ PORTAL - ENVIRONMENT CONFIGURATION
# Copy this file to .env and populate your credentials
# ========================================================

# Flask Application Settings
SECRET_KEY=generate-a-secure-random-secret-key-for-sessions
FLASK_ENV=development
PORT=5000

# Supabase PostgreSQL API Configuration
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional direct PostgreSQL connection string
# Found in: Supabase Dashboard > Project Settings > Database > Connection String
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Faculty Master Authentication Credentials
FACULTY_EMAIL=ankita.gadekar@nmiet.edu.in
FACULTY_PASSWORD=nmiet@45
